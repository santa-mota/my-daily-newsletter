# Copy to .env and fill in. Never commit .env.

# --- App ---
ENV=development
PUBLIC_BASE_URL=https://your-domain.example
PORT=8000

# WhatsApp Cloud API (Meta Developer)
# https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=choose_a_random_verify_string_for_webhook_setup

# Your personal WhatsApp number in E.164 (only this user receives digests in v1)
USER_WHATSAPP_E164=+15551234567

# LLM (OpenAI-compatible API; use OpenAI, Azure OpenAI, or local LiteLLM/Ollama proxy)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Daily digest local time (24h), server must run scheduler in this timezone
DIGEST_LOCAL_HOUR=8
DIGEST_LOCAL_MINUTE=30
DIGEST_TIMEZONE=America/Los_Angeles

# SQLite (default: file in current working directory)
DATABASE_URL=sqlite:///./newsletter.sqlite3

# Optional: require X-Trigger-Secret header for POST /internal/run-digest
TRIGGER_SECRET=
